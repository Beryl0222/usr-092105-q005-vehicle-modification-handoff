{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "汽车改装合规交接领域事件",
  "description": "用于跨模块交换事实记录的公共信封。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PART_CERTIFIED",
        "CERTIFICATE_REVOKED",
        "PART_INSTALLED",
        "INSTALLATION_CALIBRATED",
        "ODOMETER_RECORDED",
        "CONFIGURATION_INSPECTED",
        "REGISTRATION_UPDATED",
        "INSURANCE_NOTIFIED",
        "ACCIDENT_REPAIRED",
        "PART_REPLACED",
        "PART_REMOVED",
        "CONFIGURATION_RESTORED",
        "OWNERSHIP_TRANSFERRED"
      ],
      "description": "本领域事件类型，覆盖零部件认证、安装标定、检测、登记与保险告知、事故维修、替换拆除、复原与所有权变更"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "vehicle_configuration",
        "certified_part",
        "inspection_finding",
        "ownership_transfer"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "事件负载，各事件类型的必备字段见 README 与 src/domain.js"
    }
  },
  "additionalProperties": true
}
